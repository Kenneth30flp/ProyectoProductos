<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title><%= modo === "crear" ? "Nuevo proveedor" : "Editar proveedor" %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <nav class="navbar navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">ProyectoProductos</a>
    </div>
  </nav>

  <div class="container py-4">
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="card-title mb-3">
          <%= modo === "crear" ? "Nuevo proveedor" : "Editar proveedor" %>
        </h2>

        <div class="mb-3">
          <a href="/proveedores" class="btn btn-secondary">Volver</a>
        </div>

        <% if (errores && errores.length) { %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% errores.forEach(e => { %>
                <li><%= e %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <% if (modo === "crear") { %>
          <form action="/proveedores/nuevo" method="POST" class="row g-3">
        <% } else { %>
          <form action="/proveedores/editar/<%= proveedor.IdProveedor %>?_method=PUT" method="POST" class="row g-3">
        <% } %>

          <div class="col-md-6">
            <label class="form-label">Nombre del proveedor</label>
            <input
              type="text"
              name="NombreProveedor"
              class="form-control"
              value="<%= proveedor.NombreProveedor || '' %>"
              required
              maxlength="100"
            />
          </div>

          <div class="col-md-6">
            <label class="form-label">Teléfono</label>
            <input
              type="text"
              name="Telefono"
              class="form-control"
              value="<%= proveedor.Telefono || '' %>"
              maxlength="15"
            />
          </div>

          <div class="col-md-6">
            <label class="form-label">Correo electrónico</label>
            <input
              type="email"
              name="CorreoElectronico"
              class="form-control"
              value="<%= proveedor.CorreoElectronico || '' %>"
              maxlength="100"
            />
          </div>

          <div class="col-md-6">
            <label class="form-label">Dirección</label>
            <input
              type="text"
              name="Direccion"
              class="form-control"
              value="<%= proveedor.Direccion || '' %>"
              maxlength="255"
            />
          </div>

          <div class="col-12">
            <button type="submit" class="btn btn-primary">
              <%= modo === "crear" ? "Guardar proveedor" : "Actualizar proveedor" %>
            </button>
          </div>

        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>