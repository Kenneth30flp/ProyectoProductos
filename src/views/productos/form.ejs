<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title><%= modo === "crear" ? "Nuevo producto" : "Editar producto" %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <nav class="navbar navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">ProyectoProductos</a>
    </div>
  </nav>

  <div class="container py-4">
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="card-title mb-3">
          <%= modo === "crear" ? "Nuevo producto" : "Editar producto" %>
        </h2>

        <div class="mb-3">
          <a href="/productos" class="btn btn-secondary">Volver</a>
        </div>

        <% if (errores && errores.length) { %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% errores.forEach(e => { %>
                <li><%= e %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <% if (modo === "crear") { %>
          <form action="/productos/nuevo" method="POST" class="row g-3">
        <% } else { %>
          <form action="/productos/editar/<%= producto.IdProducto %>?_method=PUT" method="POST" class="row g-3">
        <% } %>

          <div class="col-md-6">
            <label class="form-label">Nombre</label>
            <input
              type="text"
              name="NombreProducto"
              class="form-control"
              value="<%= producto.NombreProducto || '' %>"
              required
              maxlength="100"
            />
          </div>

          <div class="col-md-6">
            <label class="form-label">Precio</label>
            <input
              type="number"
              name="Precio"
              class="form-control"
              step="0.01"
              min="0.01"
              value="<%= producto.Precio || '' %>"
              required
            />
          </div>

          <div class="col-md-6">
            <label class="form-label">Stock</label>
            <input
              type="number"
              name="Stock"
              class="form-control"
              min="0"
              value="<%= (producto.Stock !== undefined && producto.Stock !== null) ? producto.Stock : 0 %>"
              required
            />
          </div>

          <div class="col-12">
            <label class="form-label">Descripción</label>
            <textarea
              name="Descripcion"
              class="form-control"
              rows="4"
            ><%= producto.Descripcion || '' %></textarea>
          </div>

          <div class="col-12">
            <button type="submit" class="btn btn-primary">
              <%= modo === "crear" ? "Guardar producto" : "Actualizar producto" %>
            </button>
          </div>

        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>