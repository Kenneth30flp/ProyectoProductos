<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mi Perfil</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body style="background:#f4f7fb;">

<div class="container py-4">

    <!-- HEADER NUEVO -->
    <div class="d-flex justify-content-between align-items-center mb-4 perfil-header">
        <div>
            <h3 class="mb-1 fw-bold">
                <i class="bi bi-person-circle text-primary me-2"></i>Mi perfil
            </h3>
            <p class="text-muted mb-0">Gestiona tu información personal y seguridad de la cuenta</p>
        </div>

        <a href="/" class="btn btn-outline-primary btn-volver-menu">
            <i class="bi bi-arrow-left me-2"></i>Volver al menú
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body text-center p-4">
                    <img
                        src="<%= usuario.Foto ? usuario.Foto : 'https://cdn-icons-png.flaticon.com/512/149/149071.png' %>"
                        alt="Foto de perfil"
                        class="rounded-circle mb-3"
                        width="140"
                        height="140"
                        style="object-fit: cover;"
                    >

                    <h4 class="fw-bold mb-1">
                        <%= usuario.Nombres ? usuario.Nombres : usuario.NombreUsuario %>
                        <%= usuario.Apellidos ? usuario.Apellidos : '' %>
                    </h4>

                    <p class="text-muted mb-1">@<%= usuario.NombreUsuario %></p>
                    <p class="text-muted"><%= usuario.CorreoElectronico %></p>

                    <div class="mt-3 p-3 bg-light rounded-4">
                        <small class="text-muted d-block">Fecha de registro</small>
                        <strong><%= new Date(usuario.FechaRegistro).toLocaleDateString() %></strong>
                    </div>

                    <hr class="my-4">

                    <form action="/perfil/foto" method="POST" enctype="multipart/form-data">
                        <div class="mb-3 text-start">
                            <label class="form-label fw-semibold">Cambiar foto de perfil</label>
                            <input type="file" name="foto" class="form-control" accept=".jpg,.jpeg,.png,.webp" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill">
                            <i class="bi bi-image me-1"></i>Actualizar foto
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <% if (success) { %>
                <div class="alert alert-success rounded-4 shadow-sm border-0"><%= success %></div>
            <% } %>

            <% if (error) { %>
                <div class="alert alert-danger rounded-4 shadow-sm border-0"><%= error %></div>
            <% } %>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">
                        <i class="bi bi-person-lines-fill text-primary me-2"></i>Información personal
                    </h4>

                    <form action="/perfil/actualizar" method="POST">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Nombres</label>
                                <input type="text" name="nombres" class="form-control" value="<%= usuario.Nombres || '' %>">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Apellidos</label>
                                <input type="text" name="apellidos" class="form-control" value="<%= usuario.Apellidos || '' %>">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Nombre de usuario</label>
                                <input type="text" name="nombreUsuario" class="form-control" value="<%= usuario.NombreUsuario %>" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Correo electrónico</label>
                                <input type="email" name="correoElectronico" class="form-control" value="<%= usuario.CorreoElectronico %>" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Teléfono</label>
                                <input type="text" name="telefono" class="form-control" value="<%= usuario.Telefono || '' %>">
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Dirección</label>
                                <textarea name="direccion" class="form-control" rows="3"><%= usuario.Direccion || '' %></textarea>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-primary rounded-pill px-4">
                                    <i class="bi bi-check2-circle me-1"></i>Guardar cambios
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">
                        <i class="bi bi-shield-lock text-danger me-2"></i>Seguridad
                    </h4>

                    <form action="/perfil/password" method="POST">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label">Contraseña actual</label>
                                <input type="password" name="passwordActual" class="form-control" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Nueva contraseña</label>
                                <input type="password" name="nuevaPassword" class="form-control" required>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Confirmar nueva contraseña</label>
                                <input type="password" name="confirmarPassword" class="form-control" required>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-danger rounded-pill px-4">
                                    <i class="bi bi-key me-1"></i>Cambiar contraseña
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.perfil-header {
    background: #ffffff;
    padding: 18px 22px;
    border-radius: 18px;
    border: 1px solid #e9eef5;
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
}

.btn-volver-menu {
    border-radius: 999px;
    padding: 10px 18px;
    font-weight: 600;
    transition: all 0.2s ease;
}

.btn-volver-menu:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(13, 110, 253, 0.15);
}
</style>

</body>
</html>