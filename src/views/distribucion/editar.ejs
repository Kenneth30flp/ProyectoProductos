<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar Distribución</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container py-5">
    <div class="card shadow mx-auto" style="max-width: 700px;">
        <div class="card-header bg-warning">
            <h3 class="mb-0">Editar distribución</h3>
        </div>

        <div class="card-body">
            <form action="/distribucion/editar/<%= relacion.IdDistribucion %>" method="POST">
                <div class="mb-3">
                    <label class="form-label">Producto</label>
                    <input type="text" class="form-control" value="<%= relacion.NombreProducto %>" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label">Proveedor</label>
                    <input type="text" class="form-control" value="<%= relacion.NombreProveedor %>" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label">Cantidad actual</label>
                    <input type="number" class="form-control" value="<%= relacion.CantidadSuministrada %>" readonly>
                </div>

                <div class="mb-3">
                    <label class="form-label">Nuevo valor de cantidad suministrada</label>
                    <input type="number" name="CantidadSuministrada" class="form-control" min="1" value="<%= relacion.CantidadSuministrada %>" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Stock actual del producto</label>
                    <input type="number" class="form-control" value="<%= relacion.Stock %>" readonly>
                </div>

                <button type="submit" class="btn btn-primary">Actualizar distribución</button>
                <a href="/distribucion" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
</body>
</html>