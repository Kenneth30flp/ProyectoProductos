<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nueva Salida | ProyectoProductos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            background-color: #f5f7fb;
        }
        .form-card {
            background: white;
            border-radius: 18px;
            padding: 28px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.06);
            max-width: 760px;
            margin: 0 auto;
        }
        .form-control, .form-select {
            border-radius: 12px;
            padding: 12px 14px;
        }
        .btn {
            border-radius: 12px;
            padding: 11px 16px;
            font-weight: 600;
        }
        .info-box {
            border-radius: 14px;
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            padding: 14px 16px;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <div class="form-card">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <h2 class="fw-bold mb-1">
                        <i class="bi bi-plus-square me-2 text-primary"></i>
                        Registrar salida
                    </h2>
                    <p class="text-muted mb-0">Descuenta existencias del producto seleccionado.</p>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a href="/salidas" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                </div>
            </div>

            <% if (typeof errorLocal !== 'undefined' && errorLocal) { %>
                <div class="alert alert-danger"><%= errorLocal %></div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <form action="/salidas/nueva" method="POST">
                <div class="mb-3">
                    <label for="idProducto" class="form-label fw-semibold">Producto</label>
                    <select name="idProducto" id="idProducto" class="form-select" required>
                        <option value="">Seleccione un producto</option>
                        <% for (let i = 0; i < productos.length; i++) { %>
                            <% let producto = productos[i]; %>
                            <option
                                value="<%= producto.IdProducto %>"
                                data-stock="<%= producto.Stock %>"
                                <%= String(old && old.idProducto) === String(producto.IdProducto) ? 'selected' : '' %>>
                                <%= producto.NombreProducto %> - Stock actual: <%= producto.Stock %>
                            </option>
                        <% } %>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="cantidad" class="form-label fw-semibold">Cantidad a retirar</label>
                    <input
                        type="number"
                        name="cantidad"
                        id="cantidad"
                        class="form-control"
                        min="1"
                        value="<%= old && old.cantidad ? old.cantidad : '' %>"
                        placeholder="Ingrese la cantidad"
                        required
                    >
                </div>

                <div class="info-box mb-4">
                    <span class="fw-semibold">Stock disponible del producto seleccionado:</span>
                    <span id="stockDisponible" class="ms-2 text-primary fw-bold">-</span>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Registrar salida
                    </button>
                    <a href="/salidas" class="btn btn-outline-dark">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <script>
        const selectProducto = document.getElementById('idProducto');
        const stockDisponible = document.getElementById('stockDisponible');

        function actualizarStockVisible() {
            const option = selectProducto.options[selectProducto.selectedIndex];
            const stock = option ? option.getAttribute('data-stock') : null;
            stockDisponible.textContent = stock ? stock + ' unidades' : '-';
        }

        selectProducto.addEventListener('change', actualizarStockVisible);
        actualizarStockVisible();
    </script>
</body>
</html>